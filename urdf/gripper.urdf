<?xml version="1.0"?>
<!-- Steerbot Gripper URDF Model -->
<!-- This describes the gripper robot for RViz visualization -->
<robot name="steerbot_gripper">

  <!-- ========================================================================================= -->
  <!-- GRIPPER DEFINITION                                                                        -->
  <!-- ========================================================================================= -->

  <!-- Base Link (Reference Frame) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="clear">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>
  </link>

  <!-- Gripper Base -->
  <link name="gripper_base">
    <visual>
      <geometry>
        <box size="0.15 0.10 0.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.3 0.3 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.10 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="base_to_gripper" type="fixed">
    <parent link="base_link"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>

  <!-- Left Finger -->
  <link name="left_finger">
    <visual>
      <geometry>
        <box size="0.02 0.03 0.15"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.03 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <origin xyz="-0.06 0 -0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.06" upper="0.0" effort="100" velocity="0.1"/>
  </joint>

  <!-- Right Finger -->
  <link name="right_finger">
    <visual>
      <geometry>
        <box size="0.02 0.03 0.15"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.03 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <origin xyz="0.06 0 -0.05" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.06" upper="0.0" effort="100" velocity="0.1"/>
  </joint>

  <!-- ========================================================================================= -->
  <!-- MOCK STEERING WHEEL (For Visualization Context)                                           -->
  <!-- ========================================================================================= -->
  <!-- Steering Wheel -->
  <link name="steering_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.175" length="0.04"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.175" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="wheel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="steering_wheel"/>
    <origin xyz="0 0 0.15" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="50" velocity="1.0"/>
  </joint>

  <!-- Wheel Center Hub -->
  <link name="wheel_hub">
    <visual>
      <geometry>
        <box size="0.08 0.08 0.02"/>
      </geometry>
      <material name="very_dark">
        <color rgba="0.02 0.02 0.02 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="hub_joint" type="fixed">
    <parent link="steering_wheel"/>
    <child link="wheel_hub"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
